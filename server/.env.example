# ============ 服务配置 ============
PORT=3001

# 后台管理密码（默认 admin123）
ADMIN_PASSWORD=admin123

# ============ 平台密钥（未配置时自动使用 Mock 数据源）============
# 淘宝/天猫联盟（阿里妈妈）开放平台
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=

# 京东联盟开放平台
JD_APP_KEY=
JD_APP_SECRET=
JD_UNION_ID=

# 拼多多多多客/进宝
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=

# 1688 分销客
ALI1688_APP_KEY=
ALI1688_APP_SECRET=

# ============ 国际快递 API 密钥（也可在后台管理界面填写）============
# 未填写时自动使用"估算模式"费率表报价
# 云途物流开放平台：https://open.yuntrack.com
CARRIER_YUNTRACK_APP_ID=
CARRIER_YUNTRACK_APP_TOKEN=
# 递四方开放平台：https://open.4px.com
CARRIER_4PX_APP_KEY=
CARRIER_4PX_APP_SECRET=
# DHL Express API
CARRIER_DHL_API_KEY=
CARRIER_DHL_API_SECRET=
# UPS Developer API
CARRIER_UPS_CLIENT_ID=
CARRIER_UPS_CLIENT_SECRET=
# FedEx Developer API
CARRIER_FEDEX_API_KEY=
CARRIER_FEDEX_API_SECRET=
# 中国邮政 EMS
CARRIER_EMS_USER_ID=
CARRIER_EMS_API_KEY=

# ============ 跨境比价参数 ============
# 默认目的国（ISO 3166-1 alpha-2）
DEFAULT_DEST_COUNTRY=US
# 默认目标货币（ISO 4217）
DEFAULT_CURRENCY=USD
# 平台服务费率（0.05 = 5%）
SERVICE_FEE_RATE=0.05
# 支付手续费率
PAYMENT_FEE_RATE=0.03
# 期望利润加成比例（默认 0，实际以各商品设置为准）
PROFIT_RATE=0.08
# 中国境内运费（元/kg，默认包邮取 0）
DOMESTIC_SHIPPING_CNY_PER_KG=0

# ============ 汇率缓存 ============
# 汇率缓存时长（分钟）
FX_CACHE_MINUTES=720
