# ===== CrossBuy 后端环境变量 =====
# 复制为 .env 后按需修改；留空的项目使用内置默认值（本地开发可直接用）

# --- 服务 ---
PORT=3001
NODE_ENV=production

# --- 数据库（MariaDB / MySQL） ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=crossbuy
MYSQL_PASSWORD=change-me-strong-password
MYSQL_DATABASE=crossbuy

# --- 跨境比价参数 ---
DEFAULT_DEST_COUNTRY=US
DEFAULT_CURRENCY=USD
SERVICE_FEE_RATE=0.05
PAYMENT_FEE_RATE=0.03
# 利润率：商品售价 = 原价 x (1 + PROFIT_RATE)，默认 0.5 即原价 x1.5
PROFIT_RATE=0.5
DOMESTIC_SHIPPING_CNY_PER_KG=0
FX_CACHE_MINUTES=720

# --- 电商平台 API（留空则该平台使用演示数据） ---
# 淘宝/天猫开放平台 https://open.taobao.com
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
# 京东联盟 https://union.jd.com
JD_APP_KEY=
JD_APP_SECRET=
JD_UNION_ID=
# 拼多多开放平台 https://open.pinduoduo.com
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=
# 1688 开放平台 https://open.1688.com
ALI1688_APP_KEY=
ALI1688_APP_SECRET=

# --- 快递商凭据说明 ---
# 快递商（zjhygj/ptdsgj 等）凭据存放在数据库 settings 表中，
# 登录后台 #/admin -> 系统设置 -> 快递商 页面配置，无需写进环境变量。

# --- 中国邮政 EMS（中小电商企业接口规范 V2.7） ---
# 网关/客户代码/授权码来自邮政开放平台；VPS 公网 IP 需加入协议客户白名单
CARRIER_EMS_SENDER_NO=
CARRIER_EMS_AUTHORIZATION=
CARRIER_EMS_USER_CODE=
CARRIER_EMS_BASE_URL=https://api.ems.com.cn/amp-prod-api/f/amp/api/open
CARRIER_EMS_SIGN_KEY=
CARRIER_EMS_PRODUCT_CODE=115104300000691
CARRIER_EMS_SENDER_ADDRESS=
CARRIER_EMS_DEFAULT_RECEIVE_INFO=
